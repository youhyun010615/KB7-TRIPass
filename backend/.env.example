# =====================================================
# TRIPass 백엔드 환경변수 템플릿
# 이 파일을 .env 또는 application-local.properties 로 복사해서 실제 값 입력
# 실제 값이 입력된 파일은 절대 커밋하지 마세요 (gitignore 처리됨)
# =====================================================

# --- Database ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# --- CODEF (자산 연동 API) ---
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=

# --- 환율 API ---
EXCHANGE_API_KEY=

# --- OCR API ---
OCR_API_KEY=
